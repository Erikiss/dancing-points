{
  "name": "dancing-points-vr",
  "version": "0.1.0",
  "private": true,
  "description": "Dancing Points VR - Just-Dance-style WebXR dance game for Meta Quest 2 built on the Dancing Points three-point motion technology",
  "type": "module",
  "scripts": {
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "node --test tests/e2e/*.test.js",
    "test:all": "npm test && npm run test:e2e",
    "start": "node server/server.js --http",
    "start:http": "node server/server.js --http --no-https",
    "gen:choreos": "node tools/gen_choreos.js",
    "postinstall": "cd server && npm install --no-audit --no-fund"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright-core": "1.63.0"
  },
  "license": "MIT"
}
